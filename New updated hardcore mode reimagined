-- Generic wrapper function to compile custom entity streams
local function createSpawnerFunction(url, meshId)
    return function()
        task.spawn(function()
            local success, sourceCode = pcall(function()
                return game:HttpGet(url)
            end)
            if success and sourceCode then
                local loadedFunc = loadstring(sourceCode)
                if loadedFunc then
                    pcall(loadedFunc)
                    
                    if meshId then
                        task.wait(0.5)
                        for _, model in pairs(workspace:GetChildren()) do
                            if model:IsA("Model") and not Players:GetPlayerFromCharacter(model) then
                                for _, descendant in pairs(model:GetDescendants()) do
                                    if descendant:IsA("MeshPart") or descendant:IsA("SpecialMesh") then
                                        pcall(function()
                                            descendant.MeshId = "rbxassetid://" .. tostring(meshId)
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end

-- Dynamic Choice-driven Rebound spawner initialization
local function spawnSelectedRebound()
    if chosenReboundURL ~= "" then
        local success, sourceCode = pcall(function() return game:HttpGet(chosenReboundURL) end)
