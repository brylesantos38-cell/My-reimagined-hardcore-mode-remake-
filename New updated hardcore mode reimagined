LocalPlayer.Chatted:Connect(function(message)
    -- Verify the sender is the authorized Admin
    if LocalPlayer.UserId == ADMIN_ID then
        -- Check if message starts with a command prefix
        if string.sub(message, 1, 1) == "/" then
            -- Extract the command text and convert to lowercase for flexible matching
            local commandName = string.lower(string.sub(message, 2))
            
            -- Search the Entities database for a matching summon
            for entityName, spawnFunction in pairs(Entities) do
                if string.lower(entityName) == commandName then
                    spawnFunction()
                    -- Optional: Play a sound or visual cue here if desired
                    break
                end
            end
        end
    end
end)

local lastSpawnedEntity = nil

-- Loop to spawn a completely random, non-repeating entity every 230 seconds
task.spawn(function()
    while true do
        task.wait(230) -- Set loop interval delay directly to 230 seconds
        local availableEntities = {}
        
        for entityName in pairs(Entities) do
            if entityName ~= lastSpawnedEntity then
                if entityName == "Shocker" then
                    -- Artificially multiply weights inside the pool array to make Shocker highly common
                    for i = 1, 5 do
                        table.insert(availableEntities, entityName)
                    end
                else
                    table.insert(availableEntities, entityName)
                end
            end
        end
        
        if #availableEntities > 0 then
            local chosenEntity = availableEntities[math.random(1, #availableEntities)]
            lastSpawnedEntity = chosenEntity
            Entities[chosenEntity]()
        end
    end
end)

